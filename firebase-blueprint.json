        "lastBackupAnnouncement": {
          "type": "object"
        },
        "programmers": {
          "type": "array"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "revision",
        "activePlayerDatabaseId",
        "activeTargetConfig",
        "playerDatabases",
        "backupDatabases",
        "programmers",
        "updatedBy",
        "updatedByName",
        "updatedAt"
      ]
    }
