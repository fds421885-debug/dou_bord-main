    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile containing verified identity and four-part name",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullNameQuad": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullNameQuad", "email", "createdAt", "updatedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Synchronized classroom quiz session managed by a supervisor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supervisorId": {
          "type": "string",
