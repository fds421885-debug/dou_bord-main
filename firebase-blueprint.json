{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile containing verified identity and four-part name",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullNameQuad": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullNameQuad", "email", "createdAt", "updatedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Synchronized classroom quiz session managed by a supervisor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supervisorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "supervisorName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "active", "finished"]
        },
        "sessionType": {
          "type": "string",
          "enum": ["quiz", "interactive"]
        },
        "mode": {
          "type": "string",
          "enum": ["quiz", "explain", "competition"]
        },
        "explainPresenterId": {
          "type": "string",
          "maxLength": 128
        },
        "explainPresenterName": {
          "type": "string",
          "maxLength": 120
        },
        "explainBlockedIds": {
          "type": "array",
          "description": "List of participant UIDs blocked by the supervisor from writing on the Explain Mode board"
        },
        "interactiveEditor": {
          "type": "string",
          "maxLength": 128
        },
        "interactiveEditorName": {
          "type": "string",
          "maxLength": 120
        },
        "currentSlideIndex": {
          "type": "integer"
        },
        "slideCount": {
          "type": "integer"
        },
        "currentQuestionId": {
          "type": "string",
          "maxLength": 128
        },
        "questionCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "supervisorId",
        "supervisorName",
        "status",
        "sessionType",
        "mode",
        "explainPresenterId",
        "explainPresenterName",
        "interactiveEditor",
        "interactiveEditorName",
        "currentSlideIndex",
        "slideCount",
        "currentQuestionId",
        "questionCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Participant": {
      "title": "Participant",
