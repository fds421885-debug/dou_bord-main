          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "supervisorName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "active", "finished"]
        },
        "sessionType": {
          "type": "string",
          "enum": ["quiz", "interactive"]
        },
        "mode": {
          "type": "string",
          "enum": ["quiz", "explain", "competition"]
        },
        "explainPresenterId": {
          "type": "string",
          "maxLength": 128
        },
        "explainPresenterName": {
          "type": "string",
          "maxLength": 120
        },
        "explainBlockedIds": {
          "type": "array",
          "description": "List of participant UIDs blocked by the supervisor from writing on the Explain Mode board"
        },
        "interactiveEditor": {
          "type": "string",
          "maxLength": 128
        },
        "interactiveEditorName": {
          "type": "string",
          "maxLength": 120
        },
        "currentSlideIndex": {
          "type": "integer"
        },
        "slideCount": {
          "type": "integer"
        },
        "currentQuestionId": {
          "type": "string",
          "maxLength": 128
        },
        "questionCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
