rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isNotExplainBlocked(roomData) {
      return !('explainBlockedIds' in roomData) || !(request.auth.uid in roomData.explainBlockedIds);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullNameQuad', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullNameQuad', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.fullNameQuad is string && data.fullNameQuad.size() >= 5 && data.fullNameQuad.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
          'id', 'title', 'supervisorId', 'supervisorName', 'status',
          'sessionType', 'mode', 'explainPresenterId', 'explainPresenterName',
          'interactiveEditor', 'interactiveEditorName', 'currentSlideIndex', 'slideCount',
          'currentQuestionId', 'questionCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'supervisorId', 'supervisorName', 'status',
          'sessionType', 'mode', 'explainPresenterId', 'explainPresenterName', 'explainBlockedIds',
          'interactiveEditor', 'interactiveEditorName', 'currentSlideIndex', 'slideCount',
          'currentQuestionId', 'questionCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isValidId(data.supervisorId)
        && data.supervisorName is string && data.supervisorName.size() >= 5 && data.supervisorName.size() <= 120
        && data.status in ['waiting', 'active', 'finished']
        && data.sessionType in ['quiz', 'interactive']
        && data.mode in ['quiz', 'explain', 'competition']
        && data.explainPresenterId is string && data.explainPresenterId.size() <= 128
        && data.explainPresenterName is string && data.explainPresenterName.size() <= 120
        && (!('explainBlockedIds' in data) || (
          data.explainBlockedIds is list
          && data.explainBlockedIds.size() <= 100
          && (data.explainBlockedIds.size() == 0 || isValidId(data.explainBlockedIds[0]))
        ))
        && data.interactiveEditor is string && data.interactiveEditor.size() >= 1 && data.interactiveEditor.size() <= 128
        && data.interactiveEditorName is string && data.interactiveEditorName.size() >= 1 && data.interactiveEditorName.size() <= 120
        && data.currentSlideIndex is int && data.currentSlideIndex >= 0 && data.currentSlideIndex <= 100
        && data.slideCount is int && data.slideCount >= 0 && data.slideCount <= 100
        && data.currentQuestionId is string && data.currentQuestionId.size() <= 128
        && data.questionCount is int && data.questionCount >= 0 && data.questionCount <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedBoard(data) {
      return data.keys().hasAll([
          'roomId', 'strokes', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'strokes', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && isValidId(data.roomId)
        && data.strokes is list && data.strokes.size() <= 400
        && (data.strokes.size() == 0 || data.strokes[0] is map)
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidExplainLayer(data) {
      return data.keys().hasAll(['id', 'roomId', 'authorId', 'authorName', 'strokes', 'updatedAt'])
        && data.keys().hasOnly(['id', 'roomId', 'authorId', 'authorName', 'strokes', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.strokes is list && data.strokes.size() <= 400
        && (data.strokes.size() == 0 || data.strokes[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidSlide(data) {
      return data.keys().hasAll(['id', 'roomId', 'pageIndex', 'imageData', 'createdAt'])
        && data.keys().hasOnly(['id', 'roomId', 'pageIndex', 'imageData', 'fileId', 'fileName', 'filePageIndex', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && data.pageIndex is int && data.pageIndex >= 1 && data.pageIndex <= 100
        && data.imageData is string && data.imageData.size() >= 10 && data.imageData.size() <= 480000
        && (!('fileId' in data) || isValidId(data.fileId))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160))
        && (!('filePageIndex' in data) || (data.filePageIndex is int && data.filePageIndex >= 1 && data.filePageIndex <= 100))
        && data.createdAt is timestamp;
    }

    function isValidSlideLayer(data) {
      return data.keys().hasAll(['id', 'roomId', 'slideId', 'authorId', 'authorName', 'strokes', 'updatedAt'])
        && data.keys().hasOnly(['id', 'roomId', 'slideId', 'authorId', 'authorName', 'strokes', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && isValidId(data.slideId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.strokes is list && data.strokes.size() <= 400
        && (data.strokes.size() == 0 || data.strokes[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll([
          'uid', 'roomId', 'fullNameQuad', 'score', 'correctCount', 'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'roomId', 'fullNameQuad', 'score', 'correctCount', 'joinedAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidId(data.roomId)
        && data.fullNameQuad is string && data.fullNameQuad.size() >= 5 && data.fullNameQuad.size() <= 120
        && data.score is int && data.score >= 0 && data.score <= 100000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'orderIndex', 'text', 'imageData', 'status',
          'attemptsUsed', 'wrongStudentIds', 'winnerId', 'winnerName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'orderIndex', 'text', 'imageData', 'choices', 'chart', 'figure',
          'questionType', 'table', 'explanationTable', 'explanationComparison', 'sourceQuizTitle',
          'status', 'attemptsUsed', 'wrongStudentIds', 'winnerId', 'winnerName', 'timerSeconds',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && data.orderIndex is int && data.orderIndex >= 1 && data.orderIndex <= 200
        && data.text is string && data.text.size() <= 2000
        && data.imageData is string && data.imageData.size() <= 480000
        && (!('choices' in data) || (
          data.choices is list
          && data.choices.size() <= 8
          && (data.choices.size() == 0 || (data.choices[0] is string && data.choices[0].size() <= 500))
        ))
        && (!('chart' in data) || data.chart is map)
        && (!('figure' in data) || data.figure is map)
        && (!('questionType' in data) || data.questionType in ['mcq', 'table'])
        && (!('table' in data) || data.table is map)
        && (!('explanationTable' in data) || data.explanationTable is map)
        && (!('explanationComparison' in data) || data.explanationComparison is map)
        && (!('sourceQuizTitle' in data) || (data.sourceQuizTitle is string && data.sourceQuizTitle.size() <= 120))
        && data.status in ['solving', 'correct', 'unanswered']
        && data.attemptsUsed is int && data.attemptsUsed >= 0 && data.attemptsUsed <= 2
        && data.wrongStudentIds is list && data.wrongStudentIds.size() <= 2
        && (data.wrongStudentIds.size() == 0 || (data.wrongStudentIds[0] is string && data.wrongStudentIds[0].size() <= 128))
        && (data.wrongStudentIds.size() < 2 || (data.wrongStudentIds[1] is string && data.wrongStudentIds[1].size() <= 128))
        && data.winnerId is string && data.winnerId.size() <= 128
        && data.winnerName is string && data.winnerName.size() <= 120
        && (!('timerSeconds' in data) || (data.timerSeconds is int && data.timerSeconds >= 0 && data.timerSeconds <= 3600))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoard(data) {
      return data.keys().hasAll([
          'studentId', 'studentName', 'roomId', 'questionId', 'strokes',
          'submitted', 'verdict', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'studentId', 'studentName', 'roomId', 'questionId', 'strokes',
          'submitted', 'verdict', 'updatedAt'
        ])
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 5 && data.studentName.size() <= 120
        && isValidId(data.roomId)
        && isValidId(data.questionId)
        && data.strokes is list && data.strokes.size() <= 400
        && (data.strokes.size() == 0 || data.strokes[0] is map)
        && data.submitted is bool
        && data.verdict in ['pending', 'correct', 'wrong']
        && data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'settings', 'questions', 'answers',
          'score', 'total', 'durationSec', 'finishedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'settings', 'questions', 'answers', 'tableAnswers',
          'score', 'total', 'durationSec', 'finishedAt', 'createdAt'
        ])
        && isValidId(data.id)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.settings is map
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 10000
        && data.answers is list && data.answers.size() == data.questions.size()
        && (!('tableAnswers' in data) || data.tableAnswers is map)
        && data.score is int && data.score >= 0
        && data.total is int && data.total >= 1 && data.total <= 10000
        && data.score <= data.total
        && data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 172800
        && data.finishedAt is int && data.finishedAt > 0
        && data.createdAt is timestamp;
    }

    function isValidStarredQuestion(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'question', 'starredAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'sourceQuizId', 'sourceTitle', 'question', 'starredAt', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('sourceQuizId' in data) || (data.sourceQuizId is string && data.sourceQuizId.size() <= 120))
        && (!('sourceTitle' in data) || (data.sourceTitle is string && data.sourceTitle.size() <= 160))
        && data.question is map
        && data.starredAt is int && data.starredAt > 0
        && data.createdAt is timestamp;
    }

    function isValidMyQuiz(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'questions', 'questionCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'questions', 'questionCount',
          'parentQuizId', 'quizKind', 'drillStyle', 'sourceStarredId', 'ruleTitle',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 10000
        && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 10000
        && (!('parentQuizId' in data) || (data.parentQuizId is string && data.parentQuizId.size() <= 128))
        && (!('quizKind' in data) || data.quizKind in ['main', 'drill'])
        && (!('drillStyle' in data) || data.drillStyle in ['same_values', 'same_law_ideas', 'mixed'])
        && (!('sourceStarredId' in data) || (data.sourceStarredId is string && data.sourceStarredId.size() <= 128))
        && (!('ruleTitle' in data) || (data.ruleTitle is string && data.ruleTitle.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedTest(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'roomCode', 'title', 'userRole', 'supervisorName',
          'totalQuestions', 'participantsSummary', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'roomCode', 'title', 'userRole', 'supervisorName',
          'totalQuestions', 'participantsSummary', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.userRole in ['supervisor', 'student']
        && data.supervisorName is string && data.supervisorName.size() >= 5 && data.supervisorName.size() <= 120
        && data.totalQuestions is int && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.participantsSummary is list && data.participantsSummary.size() <= 100
        && (data.participantsSummary.size() == 0 || data.participantsSummary[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedQuestion(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'orderIndex', 'text', 'imageData', 'status',
          'winnerName', 'boards', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'orderIndex', 'text', 'imageData',
          'choices', 'correctIndex', 'explanation', 'chart', 'figure', 'explanationChart', 'explanationFigure',
          'questionType', 'table', 'explanationTable', 'explanationComparison', 'winnerTimeMs',
          'status', 'winnerName', 'boards', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.orderIndex is int && data.orderIndex >= 1 && data.orderIndex <= 200
        && data.text is string && data.text.size() <= 2000
        && data.imageData is string && data.imageData.size() <= 480000
        && (!('choices' in data) || (data.choices is list && data.choices.size() <= 8))
        && (!('correctIndex' in data) || (data.correctIndex is int && data.correctIndex >= -1 && data.correctIndex <= 7))
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 2000))
        && (!('chart' in data) || data.chart is map)
        && (!('figure' in data) || data.figure is map)
        && (!('explanationChart' in data) || data.explanationChart is map)
        && (!('explanationFigure' in data) || data.explanationFigure is map)
        && (!('questionType' in data) || data.questionType in ['mcq', 'table'])
        && (!('table' in data) || data.table is map)
        && (!('explanationTable' in data) || data.explanationTable is map)
        && (!('explanationComparison' in data) || data.explanationComparison is map)
        && (!('winnerTimeMs' in data) || (data.winnerTimeMs is int && data.winnerTimeMs >= 0 && data.winnerTimeMs <= 172800000))
        && data.status in ['solving', 'correct', 'unanswered']
        && data.winnerName is string && data.winnerName.size() <= 120
        && data.boards is list && data.boards.size() <= 100
        && (data.boards.size() == 0 || data.boards[0] is map)
        && data.createdAt is timestamp;
    }

    function isValidSharedQuiz(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'authorId', 'authorName', 'authorRole',
          'title', 'questions', 'questionCount', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'authorId', 'authorName', 'authorRole',
          'title', 'questions', 'questionCount', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && isValidId(data.authorId)
        && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.authorRole in ['supervisor', 'student']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 10000
        && (data.questions[0] is map)
        && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 10000
        && data.updatedAt is timestamp;
    }

    function isValidCompetition(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'createdBy', 'createdByName', 'title', 'settings',
          'includeSupervisor', 'competitorIds', 'competitors',
          'status', 'phase', 'currentIndex', 'totalQuestions', 'countdownSec',
          'phaseStartedAt', 'totalElapsedMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'createdBy', 'createdByName', 'title', 'settings',
          'includeSupervisor', 'competitorIds', 'competitors',
          'status', 'phase', 'currentIndex', 'totalQuestions', 'countdownSec',
          'phaseStartedAt', 'totalElapsedMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.settings is map
        && data.includeSupervisor is bool
        && data.competitorIds is list && data.competitorIds.size() >= 1 && data.competitorIds.size() <= 100
        && isValidId(data.competitorIds[0])
        && data.competitors is list && data.competitors.size() >= 1 && data.competitors.size() <= 100
        && data.competitors[0] is map
        && data.status in ['active', 'finished']
        && data.phase in ['countdown', 'question']
        && data.currentIndex is int && data.currentIndex >= 0 && data.currentIndex <= 10000
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 10000
        && data.countdownSec is int && data.countdownSec >= 1 && data.countdownSec <= 10
        && data.phaseStartedAt is timestamp
        && data.totalElapsedMs is int && data.totalElapsedMs >= 0 && data.totalElapsedMs <= 172800000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitionQuestion(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'competitionId', 'orderIndex', 'question', 'status',
          'winnerId', 'winnerName', 'winnerChoiceIndex', 'winnerTimeMs',
          'wrongPlayerIds', 'attempts', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'competitionId', 'orderIndex', 'question', 'status',
          'winnerId', 'winnerName', 'winnerChoiceIndex', 'winnerTimeMs',
          'wrongPlayerIds', 'attempts', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.roomId)
        && isValidId(data.competitionId)
        && data.orderIndex is int && data.orderIndex >= 1 && data.orderIndex <= 10000
        && data.question is map
        && data.status in ['solving', 'correct', 'unanswered']
        && data.winnerId is string && data.winnerId.size() <= 128
        && data.winnerName is string && data.winnerName.size() <= 120
        && data.winnerChoiceIndex is int && data.winnerChoiceIndex >= -1 && data.winnerChoiceIndex <= 7
        && data.winnerTimeMs is int && data.winnerTimeMs >= 0 && data.winnerTimeMs <= 172800000
        && data.wrongPlayerIds is list && data.wrongPlayerIds.size() <= 100
        && (data.wrongPlayerIds.size() == 0 || isValidId(data.wrongPlayerIds[0]))
        && data.attempts is list && data.attempts.size() <= 100
        && (data.attempts.size() == 0 || data.attempts[0] is map)
        && data.updatedAt is timestamp;
    }

    function isMasterProgrammerAuth() {
      return isVerified() && (
        request.auth.token.email == 'mohammedmonta2022m@gmail.com'
        || request.auth.token.email == 'qdrat2626@gmail.com'
      );
    }

    function isValidPlatformPointer(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'apiKey', 'authDomain', 'appId', 'migratedBy', 'migratedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'projectId', 'apiKey', 'authDomain', 'appId', 'storageBucket', 'messagingSenderId',
          'measurementId', 'firestoreDatabaseId', 'migratedBy', 'migratedByName',
          'migratedRoomId', 'migrationEpoch', 'previousConfigs', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.projectId is string && data.projectId.size() >= 4 && data.projectId.size() <= 64
        && data.projectId.matches('^[a-z0-9\\-]+$')
        && data.apiKey is string && data.apiKey.size() >= 10 && data.apiKey.size() <= 200
        && data.authDomain is string && data.authDomain.size() >= 4 && data.authDomain.size() <= 200
        && data.appId is string && data.appId.size() >= 8 && data.appId.size() <= 200
        && (!('storageBucket' in data) || (data.storageBucket is string && data.storageBucket.size() <= 200))
        && (!('messagingSenderId' in data) || (data.messagingSenderId is string && data.messagingSenderId.size() <= 64))
        && (!('measurementId' in data) || (data.measurementId is string && data.measurementId.size() <= 64))
        && (!('firestoreDatabaseId' in data) || (data.firestoreDatabaseId is string && data.firestoreDatabaseId.size() <= 128))
        && isValidId(data.migratedBy)
        && data.migratedBy == request.auth.uid
        && data.migratedByName is string && data.migratedByName.size() >= 1 && data.migratedByName.size() <= 120
        && (!('migratedRoomId' in data) || (data.migratedRoomId is string && data.migratedRoomId.size() <= 16))
        && (!('migrationEpoch' in data) || (data.migrationEpoch is string && data.migrationEpoch.size() <= 64))
        && (!('previousConfigs' in data) || (
          data.previousConfigs is list
          && data.previousConfigs.size() <= 10
          && (data.previousConfigs.size() == 0 || data.previousConfigs[0] is map)
        ))
        && data.updatedAt is timestamp;
    }

    function isValidPlatformRegistry(data) {
      return data.keys().hasAll([
          'id', 'revision', 'activePlayerDatabaseId', 'activeTargetConfig',
          'playerDatabases', 'backupDatabases', 'programmers',
          'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'revision', 'activePlayerDatabaseId', 'activeTargetConfig',
          'playerDatabases', 'backupDatabases', 'lastBackupAnnouncement', 'programmers',
          'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.revision is int && data.revision >= 1 && data.revision <= 1000000
        && data.activePlayerDatabaseId is string && data.activePlayerDatabaseId.size() <= 128
        && data.activeTargetConfig is map
        && data.playerDatabases is list && data.playerDatabases.size() <= 25
        && (data.playerDatabases.size() == 0 || data.playerDatabases[0] is map)
        && data.backupDatabases is list && data.backupDatabases.size() <= 25
        && (data.backupDatabases.size() == 0 || data.backupDatabases[0] is map)
        && (!('lastBackupAnnouncement' in data) || data.lastBackupAnnouncement is map)
        && data.programmers is list && data.programmers.size() >= 1 && data.programmers.size() <= 25
        && data.programmers[0] is map
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
