            || (incoming().status == 'unanswered'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'attemptsUsed', 'wrongStudentIds', 'updatedAt']))
          );
        allow delete: if isValidId(roomId) && isValidId(questionId) && isVerified()
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid;

        match /boards/{studentId} {
          allow get: if isValidId(roomId) && isValidId(questionId) && isValidId(studentId) && isVerified()
            && (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
              || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
            );
          allow list: if isValidId(roomId) && isValidId(questionId) && isVerified()
            && resource.data.roomId == roomId && resource.data.questionId == questionId;
          allow create: if isValidId(roomId) && isValidId(questionId) && isValidId(studentId) && isVerified()
            && studentId == request.auth.uid
            && isValidBoard(incoming())
            && incoming().studentId == request.auth.uid
            && incoming().roomId == roomId
            && incoming().questionId == questionId
            && incoming().verdict == 'pending'
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
            && get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(questionId)).data.status == 'solving';
          allow update: if isValidId(roomId) && isValidId(questionId) && isValidId(studentId) && isVerified()
            && isValidBoard(incoming())
            && incoming().studentId == existing().studentId
            && incoming().studentName == existing().studentName
            && incoming().roomId == existing().roomId
            && incoming().questionId == existing().questionId
            && incoming().updatedAt == request.time
            && (
              (studentId == request.auth.uid
                && existing().submitted == false
                && existing().verdict == 'pending'
                && get(/databases/$(database)/documents/rooms/$(roomId)/questions/$(questionId)).data.status == 'solving'
                && incoming().verdict == existing().verdict
                && incoming().diff(existing()).affectedKeys().hasOnly(['strokes', 'submitted', 'updatedAt']))
              || (get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
                && incoming().strokes == existing().strokes
                && incoming().submitted == existing().submitted
                && incoming().diff(existing()).affectedKeys().hasOnly(['verdict', 'updatedAt']))
            );
          allow delete: if isValidId(roomId) && isValidId(questionId) && isValidId(studentId) && isVerified()
            && (
              studentId == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
            );
        }
      }

      match /sharedQuizzes/{sharedQuizId} {
        allow get: if isValidId(roomId) && isValidId(sharedQuizId) && isVerified()
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          );
        allow list: if isValidId(roomId) && isVerified() && resource.data.roomId == roomId;
        allow create: if isValidId(roomId) && isValidId(sharedQuizId) && isVerified()
          && isValidSharedQuiz(incoming())
          && incoming().id == sharedQuizId
          && incoming().roomId == roomId
          && incoming().authorId == request.auth.uid
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'finished'
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          );
        allow update: if isValidId(roomId) && isValidId(sharedQuizId) && isVerified()
          && isValidSharedQuiz(incoming())
          && existing().authorId == request.auth.uid
          && incoming().id == existing().id
          && incoming().roomId == existing().roomId
          && incoming().authorId == existing().authorId
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'finished'
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'authorName', 'authorRole', 'title', 'questions', 'questionCount', 'updatedAt'
          ]);
        allow delete: if isValidId(roomId) && isValidId(sharedQuizId) && isVerified()
          && (
            existing().authorId == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
          );
      }

      match /competitions/{compId} {
        allow get: if isValidId(roomId) && isValidId(compId) && isVerified()
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          );
        allow list: if isValidId(roomId) && isVerified() && resource.data.roomId == roomId;
        allow create: if isValidId(roomId) && isValidId(compId) && isVerified()
          && isValidCompetition(incoming())
          && incoming().id == compId
          && incoming().roomId == roomId
          && incoming().createdBy == request.auth.uid
          && incoming().status == 'active'
          && incoming().phase == 'countdown'
          && incoming().currentIndex == 0
          && incoming().totalElapsedMs == 0
          && incoming().phaseStartedAt == request.time
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'active'
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
            || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
          );
        allow update: if isValidId(roomId) && isValidId(compId) && isVerified()
          && isValidCompetition(incoming())
          && existing().status == 'active'
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'active'
          && incoming().id == existing().id
          && incoming().roomId == existing().roomId
          && incoming().createdBy == existing().createdBy
          && incoming().createdByName == existing().createdByName
          && incoming().title == existing().title
          && incoming().settings == existing().settings
          && incoming().includeSupervisor == existing().includeSupervisor
          && incoming().competitorIds == existing().competitorIds
          && incoming().competitors == existing().competitors
          && incoming().totalQuestions == existing().totalQuestions
          && incoming().countdownSec == existing().countdownSec
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              (
                get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
                || existing().createdBy == request.auth.uid
                || request.auth.uid in existing().competitorIds
              )
              && (
                (existing().phase == 'countdown' && incoming().phase == 'question'
                  && incoming().status == 'active'
                  && incoming().phaseStartedAt == request.time
                  && incoming().currentIndex <= existing().currentIndex + 1
                  && incoming().diff(existing()).affectedKeys().hasOnly(['phase', 'currentIndex', 'phaseStartedAt', 'updatedAt']))
                || (existing().phase == 'question' && incoming().phase == 'countdown'
                  && incoming().status == 'active'
                  && incoming().phaseStartedAt == request.time
                  && incoming().diff(existing()).affectedKeys().hasOnly(['phase', 'phaseStartedAt', 'totalElapsedMs', 'updatedAt']))
                || (incoming().status == 'finished'
                  && (
                    get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
                    || existing().createdBy == request.auth.uid
                    || request.auth.uid in existing().competitorIds
                  )
                  && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'totalElapsedMs', 'updatedAt']))
              )
            )
          );
        allow delete: if isValidId(roomId) && isValidId(compId) && isVerified()
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid;

        match /questions/{qDocId} {
          allow get: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isVerified()
            && (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
              || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
            );
          allow list: if isValidId(roomId) && isValidId(compId) && isVerified()
            && resource.data.roomId == roomId && resource.data.competitionId == compId;
          allow create: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isVerified()
            && isValidCompetitionQuestion(incoming())
            && incoming().id == qDocId
            && incoming().roomId == roomId
            && incoming().competitionId == compId
            && incoming().status == 'solving'
            && incoming().winnerId == ''
            && incoming().winnerName == ''
            && incoming().winnerChoiceIndex == -1
            && incoming().winnerTimeMs == 0
            && incoming().wrongPlayerIds.size() == 0
            && incoming().attempts.size() == 0
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId))
            && (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId)).data.createdBy == request.auth.uid
            );
          allow update: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isVerified()
            && isValidCompetitionQuestion(incoming())
            && existing().status == 'solving'
            && get(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId)).data.status == 'active'
            && incoming().id == existing().id
            && incoming().roomId == existing().roomId
            && incoming().competitionId == existing().competitionId
            && incoming().orderIndex == existing().orderIndex
            && incoming().question == existing().question
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'winnerId', 'winnerName', 'winnerChoiceIndex', 'winnerTimeMs',
              'wrongPlayerIds', 'attempts', 'updatedAt'
            ])
            && (
              (
                request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId)).data.competitorIds
                && !(request.auth.uid in existing().wrongPlayerIds)
                && (
                  (incoming().status == 'correct' && incoming().winnerId == request.auth.uid)
                  || incoming().status == 'solving'
                  || incoming().status == 'unanswered'
                )
              )
              || (
                incoming().status == 'unanswered'
                && (
                  get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
                  || get(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId)).data.createdBy == request.auth.uid
                )
              )
            );
          allow delete: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isVerified()
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid;

          match /boards/{studentId} {
            allow get: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isValidId(studentId) && isVerified()
              && (
                get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
                || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
              );
            allow list: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isVerified()
              && resource.data.roomId == roomId && resource.data.questionId == qDocId;
            allow create: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isValidId(studentId) && isVerified()
              && studentId == request.auth.uid
              && isValidBoard(incoming())
              && incoming().studentId == request.auth.uid
              && incoming().roomId == roomId
              && incoming().questionId == qDocId
              && incoming().verdict == 'pending'
              && incoming().updatedAt == request.time
              && get(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId)).data.status == 'active'
              && (
                get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
                || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
              );
            allow update: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isValidId(studentId) && isVerified()
              && studentId == request.auth.uid
              && isValidBoard(incoming())
              && incoming().studentId == existing().studentId
              && incoming().studentName == existing().studentName
              && incoming().roomId == existing().roomId
              && incoming().questionId == existing().questionId
              && incoming().verdict == existing().verdict
              && incoming().updatedAt == request.time
              && get(/databases/$(database)/documents/rooms/$(roomId)/competitions/$(compId)).data.status == 'active'
              && incoming().diff(existing()).affectedKeys().hasOnly(['strokes', 'submitted', 'updatedAt']);
            allow delete: if isValidId(roomId) && isValidId(compId) && isValidId(qDocId) && isValidId(studentId) && isVerified()
              && (
                studentId == request.auth.uid
                || get(/databases/$(database)/documents/rooms/$(roomId)).data.supervisorId == request.auth.uid
              );
          }
        }
      }
    }
  }
}
